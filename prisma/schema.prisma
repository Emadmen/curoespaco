// Data model for the clinic website.
// Privacy note: appointment requests intentionally store only what is needed to
// contact the visitor (no symptoms, diagnoses or free-text health information).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
}

/// REQUEST: visitor indicates a preference, the clinic confirms (default / MVP).
/// LIVE: visitor picks a real slot computed from professionals' working hours.
enum BookingMode {
  REQUEST
  LIVE
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String   @db.Text
  description      String   @db.Text
  /// Key of an icon in src/components/services/service-icon.tsx
  icon             String   @default("sparkles")
  durationMinutes  Int      @default(50)
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([enabled, sortOrder])
}

model Professional {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  /// Specialty / role shown under the name, e.g. "Psicóloga Clínica".
  title              String
  bio                String   @db.Text
  /// Professional registration number (e.g. OPP cédula), only when applicable.
  registrationNumber String?
  /// JSON array of strings, e.g. ["Adultos", "Ansiedade"] (MySQL has no array columns).
  expertise          Json
  imageId            String?
  image              MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  /// Weekly schedule used by LIVE booking mode: { "1": [{ "start": "09:00", "end": "13:00" }], ... }
  /// Keys are ISO weekdays (1 = Monday … 7 = Sunday).
  workingHours       Json?
  enabled            Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  services     ProfessionalService[]
  appointments Appointment[]

  @@index([enabled, sortOrder])
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

/// Uploaded images (e.g. professional portraits) stored in the database so the
/// app works on any host without extra storage infrastructure.
model MediaAsset {
  id        String   @id @default(cuid())
  mimeType  String
  size      Int
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now())

  professionals Professional[]
}

model Appointment {
  id               String            @id @default(cuid())
  /// Short, human-friendly reference shown to the visitor (e.g. "CR-7KQ2MX").
  reference        String            @unique
  status           AppointmentStatus @default(PENDING)
  mode             BookingMode       @default(REQUEST)

  serviceId        String?
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// Snapshot so the record stays meaningful if the service is later renamed/removed.
  serviceName      String
  professionalId   String?
  professional     Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalName String?

  /// Preferred (REQUEST mode) or booked (LIVE mode) date, clinic local time.
  preferredDate    DateTime          @db.Date
  /// "HH:mm" in clinic local time.
  preferredTime    String
  /// Exact slot start/end (UTC) – only set in LIVE mode.
  slotStart        DateTime?
  slotEnd          DateTime?

  name             String
  phone            String
  email            String?

  consentAt        DateTime
  consentVersion   String
  /// Client-generated key that makes repeated submissions of the same form idempotent.
  idempotencyKey   String            @unique

  statusUpdatedAt  DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([preferredDate])
  @@index([phone, createdAt])
  @@index([professionalId, slotStart])
}

/// Singleton row (id = 1) with editable clinic information.
/// Defaults live in src/config/clinic.ts and are used when no row exists.
model ClinicSettings {
  id            Int         @id @default(1)
  name          String
  tagline       String      @db.Text
  phone         String
  whatsapp      String
  email         String
  addressLine1  String
  addressLine2  String?
  postalCode    String
  city          String
  country       String      @default("PT")
  mapsUrl       String?     @db.Text
  mapsEmbedUrl  String?     @db.Text
  /// [{ "day": 1, "open": "09:00", "close": "20:00" } | { "day": 7, "closed": true }]
  openingHours  Json
  /// { "instagram": "https://…", "facebook": "https://…", "linkedin": "https://…" }
  socials       Json
  bookingMode   BookingMode @default(REQUEST)
  heroTitle     String      @db.Text
  heroSubtitle  String      @db.Text
  aboutIntro    String      @db.Text
  /// Appointment requests older than this are eligible for deletion (data minimisation).
  retentionDays Int         @default(365)
  updatedAt     DateTime    @updatedAt
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  /// SHA-256 of the session token; the raw token only ever lives in the cookie.
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}
