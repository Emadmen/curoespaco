# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. For local development run `docker compose up -d`.
DATABASE_URL="mysql://cora:cora_dev_password@localhost:3307/cora"

# Used only by `npm run test:integration` (must be a separate, disposable database).
TEST_DATABASE_URL="mysql://cora:cora_dev_password@localhost:3307/cora_test"

# ─── Public site ────────────────────────────────────────────────────────────
# Canonical URL used for metadata, sitemap and structured data (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Admin bootstrap (used by `npm run db:seed` / `npm run admin:create`) ───
# The seed creates/updates this admin account. Use a long, unique password (min. 12 chars).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"

# ─── Abuse protection (optional, sensible defaults) ─────────────────────────
# Max booking requests per IP within the window.
BOOKING_RATE_LIMIT="5"
BOOKING_RATE_WINDOW_SECONDS="600"
# Requests submitted faster than this (ms after the form opened) are treated as bots.
BOOKING_MIN_FILL_MS="2500"
